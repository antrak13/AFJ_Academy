# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=
# Solo para npm run db:aplicar (Connect → Session pooler). La app no la usa.
SUPABASE_DB_URL=postgresql://postgres.<proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres

# LiveKit Cloud (voz)
LIVEKIT_URL=wss://<proyecto>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Correos (separados por comas) que pueden crear, editar y generar las preguntas de los puntos
# de control. Las preguntas las define la plataforma, no quienes estudian.
ADMINS_PLATAFORMA=

# IA (lib/ai). AI_PROVIDER: anthropic | mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

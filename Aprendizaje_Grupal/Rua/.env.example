# =====================================================================
# AFJ Academy · plantilla de variables de entorno
# Copia este archivo a .env.local (mismo directorio) y completa los valores.
# .env.local no se sube a git. En producción (Vercel) se cargan las mismas
# variables en Project Settings → Environment Variables.
#
# Un solo archivo para toda la plataforma:
#   - la app de Next (Aprendizaje_Grupal/Rua) lo carga sola
#   - el servidor de aprendines (Aprendizaje_Individual) lo lee con npm start
# =====================================================================

# --- Supabase (cuentas, base de datos, tiempo real, archivos) ---------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=
# Solo para npm run db:aplicar (Connect → Session pooler; la conexión directa db.<ref> es solo IPv6).
# La app no la usa: no hace falta en Vercel.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<clave>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- LiveKit Cloud (voz en las salas) ----------------------------------
LIVEKIT_URL=wss://<proyecto>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- IA ------------------------------------------------------------------
# Estudio grupal (lib/ai): gemini | anthropic | mock (mock = preguntas de ejemplo, sin costo)
AI_PROVIDER=gemini
# Gemini (aistudio.google.com/apikey): la usan el estudio grupal y el servidor de aprendines
GEMINI_API_KEY=
# Orden de modelos; si uno está saturado (429/503) se prueba el siguiente
GEMINI_MODELOS=gemini-3.5-flash,gemini-3.8-flash,gemini-2.5-flash
# Referencia del proyecto de Google Cloud dueño de la clave (la app no lo necesita)
GOOGLE_CLOUD_PROJECT=projects/<numero>
GOOGLE_CLOUD_PROJECT_NUMBER=
# Solo si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Plataforma ----------------------------------------------------------
# Correos (separados por comas) que pueden crear y generar las preguntas de los puntos de control.
# Las preguntas las define la plataforma, no quienes estudian.
ADMINS_PLATAFORMA=
# Dónde corre el servidor de aprendines (la app de Next le reenvía /api/estado, /api/turno…).
# En producción: la URL pública donde se despliegue Aprendizaje_Individual.
INDIVIDUAL_URL=http://127.0.0.1:8080
